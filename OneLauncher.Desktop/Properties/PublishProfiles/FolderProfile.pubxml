<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>bin\Release\Publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ReleaseArchive>$(MSBuildProjectDirectory)\bin\Release\Publish\OneLauncher-win-x64.zip</ReleaseArchive>

    <!-- Native AOT cannot embed dynamic native libraries. If matching static
         libraries are supplied, link them into the executable instead. -->
    <AvaloniaNativeLibraryDir Condition="'$(AvaloniaNativeLibraryDir)' == ''">$(MSBuildProjectDirectory)\libs</AvaloniaNativeLibraryDir>
    <UseStaticAvaloniaNativeLibraries Condition="Exists('$(AvaloniaNativeLibraryDir)\libSkiaSharp.lib') and Exists('$(AvaloniaNativeLibraryDir)\libHarfBuzzSharp.lib') and Exists('$(AvaloniaNativeLibraryDir)\av_libglesv2.lib')">true</UseStaticAvaloniaNativeLibraries>
    <UseStaticAvaloniaNativeLibraries Condition="'$(UseStaticAvaloniaNativeLibraries)' == ''">false</UseStaticAvaloniaNativeLibraries>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseStaticAvaloniaNativeLibraries)' == 'true'">
    <DirectPInvoke Include="libSkiaSharp" />
    <DirectPInvoke Include="libHarfBuzzSharp" />
    <DirectPInvoke Include="av_libglesv2" />

    <NativeLibrary Include="$(AvaloniaNativeLibraryDir)\libSkiaSharp.lib" />
    <NativeLibrary Include="$(AvaloniaNativeLibraryDir)\libHarfBuzzSharp.lib" />
    <NativeLibrary Include="$(AvaloniaNativeLibraryDir)\av_libglesv2.lib" />
  </ItemGroup>

  <Target Name="RemoveStaticallyLinkedAvaloniaNativeLibraries"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(UseStaticAvaloniaNativeLibraries)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'libSkiaSharp.dll' or '%(Filename)%(Extension)' == 'libHarfBuzzSharp.dll' or '%(Filename)%(Extension)' == 'av_libglesv2.dll'" />
    </ItemGroup>
  </Target>

  <Target Name="CreateReleaseArchive" AfterTargets="RemoveSymbolsFromPublish">
    <ZipDirectory SourceDirectory="$(PublishDir)"
                  DestinationFile="$(ReleaseArchive)"
                  Overwrite="true" />
  </Target>
</Project>

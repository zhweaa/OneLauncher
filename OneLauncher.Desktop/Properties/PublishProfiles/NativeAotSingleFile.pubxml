<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>$(MSBuildProjectDirectory)\bin\Release\Publish\win-x64-single-file\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <StartupObject>OneLauncher.Desktop.NativeAotSingleFileBootstrap</StartupObject>
    <NativeBundleResourcePrefix>OneLauncher.Native.win-x64</NativeBundleResourcePrefix>
    <NativeBundleBootstrap>$(MSBuildProjectDirectory)\Properties\PublishProfiles\NativeAotSingleFileBootstrap.cs.in</NativeBundleBootstrap>

    <!-- Keep these versions aligned with the packages selected in project.assets.json. -->
    <AvaloniaAngleNativeVersion>2.1.25547.20250602</AvaloniaAngleNativeVersion>
    <SkiaSharpNativeVersion>2.88.9</SkiaSharpNativeVersion>
    <HarfBuzzSharpNativeVersion>8.3.1.1</HarfBuzzSharpNativeVersion>
    <MsalNativeInteropVersion>0.20.6</MsalNativeInteropVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The .cs.in suffix keeps this bootstrap out of every other build/profile. -->
    <Compile Include="$(NativeBundleBootstrap)" />

    <BundledNativeLibrary Include="$(NuGetPackageRoot)avalonia.angle.windows.natives\$(AvaloniaAngleNativeVersion)\runtimes\win-x64\native\av_libglesv2.dll" />
    <BundledNativeLibrary Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\$(HarfBuzzSharpNativeVersion)\runtimes\win-x64\native\libHarfBuzzSharp.dll" />
    <BundledNativeLibrary Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\$(SkiaSharpNativeVersion)\runtimes\win-x64\native\libSkiaSharp.dll" />
    <BundledNativeLibrary Include="$(NuGetPackageRoot)microsoft.identity.client.nativeinterop\$(MsalNativeInteropVersion)\runtimes\win-x64\native\msalruntime.dll" />

    <EmbeddedResource Include="@(BundledNativeLibrary)">
      <LogicalName>$(NativeBundleResourcePrefix).%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="ValidateNativeBundleInputs" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('%(BundledNativeLibrary.Identity)')"
           Text="Native single-file input was not restored: %(BundledNativeLibrary.Identity)" />
  </Target>

  <Target Name="RemoveBundledNativeLibrariesFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'av_libglesv2.dll' or
                                        '%(Filename)%(Extension)' == 'libHarfBuzzSharp.dll' or
                                        '%(Filename)%(Extension)' == 'libSkiaSharp.dll' or
                                        '%(Filename)%(Extension)' == 'msalruntime.dll'" />
    </ItemGroup>
  </Target>

  <Target Name="FinalizeNativeAotSingleFile" AfterTargets="Publish">
    <ItemGroup>
      <BundledNativePublishCopy Include="$(PublishDir)av_libglesv2.dll;
                                         $(PublishDir)libHarfBuzzSharp.dll;
                                         $(PublishDir)libSkiaSharp.dll;
                                         $(PublishDir)msalruntime.dll" />
      <PublishedSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(BundledNativePublishCopy);@(PublishedSymbols)" />
    <Error Condition="Exists('$(PublishDir)av_libglesv2.dll') or
                      Exists('$(PublishDir)libHarfBuzzSharp.dll') or
                      Exists('$(PublishDir)libSkiaSharp.dll') or
                      Exists('$(PublishDir)msalruntime.dll')"
           Text="Native single-file publish still contains a bundled DLL." />
  </Target>
</Project>

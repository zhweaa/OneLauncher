<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Resources\**" />

  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Assets\Resources\SKGT.resx">
      <ManifestResourceName>OneLauncher.Assets.Resources.SKGT</ManifestResourceName>
      <StronglyTypedLanguage>C#</StronglyTypedLanguage>
      <StronglyTypedClassName>SKGT</StronglyTypedClassName>
      <StronglyTypedNamespace>OneLauncher.Assets.Resources</StronglyTypedNamespace>
      <StronglyTypedFileName>$(IntermediateOutputPath)SKGT.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AsyncImageLoader.Avalonia" Version="3.7.0" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
	  <!--
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.0" />
	-->
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OneLauncher.Core\OneLauncher.Core.csproj" />
  </ItemGroup>
</Project>

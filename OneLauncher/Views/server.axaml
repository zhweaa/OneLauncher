<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1070"
             d:DesignHeight="620"
             x:Class="OneLauncher.Views.server"
             xmlns:vm="using:OneLauncher.Views.ViewModels"
             xmlns:controls="using:OneLauncher.Views.Controls"
             x:CompileBindings="True"
             x:DataType="vm:ServerPageViewModel">
    <controls:PageShell IsPaneOpen="{Binding IsPaneShow, Mode=TwoWay}"
                        PaneContent="{Binding PaneContent}">
        <Grid RowDefinitions="52,*" Margin="24">
        <StackPanel Grid.Row="0"
                    Margin="16,0,0,0"
                    Orientation="Horizontal"
                    Spacing="28">
            <TextBlock Classes="page-title" Text="服务器收藏" />
            <Button Classes="toolbar-action" Command="{Binding AddServerCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Image Source="/Assets/icos/add.png"
                           Width="20"
                           Height="20" />
                    <TextBlock Text="添加" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ListBox Grid.Row="1" Classes="card-list"
                 ItemsSource="{Binding ServerList}"
                 SelectionMode="Multiple">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerItem">
                    <Border Classes="data-card" Padding="10">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              VerticalAlignment="Center">
                            <Border Grid.Column="0"
                                    CornerRadius="6"
                                    ClipToBounds="True">
                                <Image Width="64"
                                       Height="64"
                                       Source="{Binding Icon}"
                                       Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="15,0"
                                        VerticalAlignment="Center">
                                <TextBlock Classes="item-title"
                                           Text="{Binding data.Name}" />
                                <TextBlock IsVisible="{Binding HasDescription}"
                                           Margin="0,3,0,0"
                                           Classes="item-meta"
                                           Text="{Binding data.Description}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10"
                                            Margin="0,5,0,0">
                                    <TextBlock Classes="item-meta">
                                        <Run Text="实例:" />
                                        <Run Text="{Binding data.InstanceId}" />
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 IsVisible="{Binding HasPing}"
                                                 Fill="{Binding PingBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Classes="item-meta"
                                                   IsVisible="{Binding HasPing}"
                                                   Text="{Binding PingText}" />
                                    </StackPanel>
                                    <TextBlock Classes="item-meta"
                                               IsVisible="{Binding HasPlayersMax}"
                                               Text="{Binding PlayersMaxText}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="6"
                                        VerticalAlignment="Bottom">
                                <Border Classes="status-badge" IsVisible="{Binding IsDefault}">
                                    <TextBlock Text="默认" />
                                </Border>
                                <Button Classes="item-action" IsVisible="{Binding !IsDefault}"
                                        Command="{Binding $parent[UserControl].DataContext.SetAsDefaultServerCommand}"
                                        CommandParameter="{Binding data}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Image Source="/Assets/icos/pin.png"
                                               Width="16"
                                               Height="16" />
                                        <TextBlock Text="设为默认" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="item-action" Command="{Binding $parent[UserControl].DataContext.EditServerCommand}"
                                        CommandParameter="{Binding data}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Image Source="/Assets/icos/edit.png"
                                               Width="16"
                                               Height="16" />
                                        <TextBlock Text="编辑" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="Accent"
                                        Command="{Binding $parent[UserControl].DataContext.LaunchServerCommand}"
                                        CommandParameter="{Binding data}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Image Source="/Assets/icos/launch.png"
                                               Width="16"
                                               Height="16" />
                                        <TextBlock Text="启动" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
    </controls:PageShell>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1070"
             d:DesignHeight="620"
             x:Class="OneLauncher.Views.server"
             xmlns:vm="using:OneLauncher.Views.ViewModels"
             x:CompileBindings="True"
             x:DataType="vm:ServerPageViewModel">
    <SplitView IsPaneOpen="{Binding IsPaneShow, Mode=TwoWay}"
               DisplayMode="Overlay"
               OpenPaneLength="650"
               PanePlacement="Right">
        <SplitView.Pane>
            <TransitioningContentControl Background="{DynamicResource PaneBackgound}"
                                         Content="{Binding PaneContent}" />
        </SplitView.Pane>
        <Grid RowDefinitions="52,*" Margin="24">
        <StackPanel Grid.Row="0"
                    Margin="16,0,0,0"
                    Orientation="Horizontal"
                    Spacing="28">
            <TextBlock Text="服务器收藏"
                       FontSize="36" />
            <Button Command="{Binding AddServerCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Image Source="/Assets/icos/add.png"
                           Width="20"
                           Height="20" />
                    <TextBlock Text="添加" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding ServerList}"
                 Background="Transparent"
                 SelectionMode="Multiple">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerItem">
                    <Border CornerRadius="5">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              VerticalAlignment="Center">
                            <Border Grid.Column="0"
                                    CornerRadius="6"
                                    ClipToBounds="True">
                                <Image Width="64"
                                       Height="64"
                                       Source="/Assets/Imgs/basic.png" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="15,0"
                                        VerticalAlignment="Center">
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           Text="{Binding data.Name}" />
                                <TextBlock IsVisible="{Binding HasDescription}"
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="Gray"
                                           Text="{Binding data.Description}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10"
                                            Margin="0,5,0,0">
                                    <TextBlock FontSize="12"
                                               Foreground="Gray">
                                        <Run Text="地址:" />
                                        <Run Text="{Binding data.ServerInfo.Ip}" />
                                        <Run Text=":" />
                                        <Run Text="{Binding data.ServerInfo.Port}" />
                                    </TextBlock>
                                    <TextBlock FontSize="12"
                                               Foreground="Gray">
                                        <Run Text="实例:" />
                                        <Run Text="{Binding data.InstanceId}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="6"
                                        VerticalAlignment="Bottom">
                                <Border IsVisible="{Binding IsDefault}"
                                        Background="#267C3AED"
                                        CornerRadius="4"
                                        Padding="8,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="默认"
                                               FontWeight="Bold"
                                               Foreground="#7C3AED"
                                               FontSize="12" />
                                </Border>
                                <Button IsVisible="{Binding !IsDefault}"
                                        Command="{Binding $parent[UserControl].DataContext.SetAsDefaultServerCommand}"
                                        CommandParameter="{Binding data}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Image Source="/Assets/icos/pin.png"
                                               Width="16"
                                               Height="16" />
                                        <TextBlock Text="设为默认" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding $parent[UserControl].DataContext.EditServerCommand}"
                                        CommandParameter="{Binding data}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Image Source="/Assets/icos/edit.png"
                                               Width="16"
                                               Height="16" />
                                        <TextBlock Text="编辑" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="Accent"
                                        Command="{Binding $parent[UserControl].DataContext.LaunchServerCommand}"
                                        CommandParameter="{Binding data}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Image Source="/Assets/icos/launch.png"
                                               Width="16"
                                               Height="16" />
                                        <TextBlock Text="启动" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <StyleInclude Source="avares://OneLauncher/Views/Styles/TransparentListBox.axaml" />
            </ListBox.Styles>
        </ListBox>
        </Grid>
    </SplitView>
</UserControl>

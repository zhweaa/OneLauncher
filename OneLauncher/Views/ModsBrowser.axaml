<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OneLauncher.Views.ModsBrowser"
			 xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
			 xmlns:vm="using:OneLauncher.Views.ViewModels"
			 xmlns:controls="using:OneLauncher.Views.Controls"
			 x:CompileBindings="True"
			 x:DataType="vm:ModsBrowserViewModel"
			 >
	<controls:PageShell IsPaneOpen="{Binding IsPaneShow,Mode=TwoWay}"
						PaneContent="{Binding InstallModPaneContent}">
		<ScrollViewer>
			<StackPanel>
				<TextBlock Classes="page-title" Text="资源检索" Margin="24,22,24,8"/>
				<Grid Margin="24,4,24,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
					<TextBox Classes="search-field" Watermark="搜索模组、整合包或资源..."
							 Text="{Binding SearchContent}">
						<TextBox.KeyBindings>
							<KeyBinding Gesture="Enter" Command="{Binding ToSearchCommand,Mode=TwoWay}" />
						</TextBox.KeyBindings>
					</TextBox>
					<Button Grid.Column="1" Classes="toolbar-action" Command="{Binding ToSearchCommand}">
						<StackPanel Orientation="Horizontal">
							<Image Source="/Assets/icos/search.png" Width="20" Height="20"/>
							<TextBlock Text="搜索"/>
						</StackPanel>
					</Button>
					<Button Grid.Column="2" Classes="toolbar-action" Command="{Binding ClearTextBoxCommand}" IsVisible="{Binding CanClear}">
						<StackPanel Orientation="Horizontal">
							<Image Source="/Assets/icos/del.png" Width="20" Height="20" />
							<TextBlock Text="清除" /> 
						</StackPanel>
					</Button>
				</Grid>
				<ListBox Classes="card-list" ItemsSource="{Binding SearchItems}" Margin="18,0">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:ModItem">
							<Border Padding="12">
								<Grid RowDefinitions="*,*" ColumnDefinitions="100,*,Auto" >
									<Border Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" >
										<Image Width="72" Height="72" asyncImageLoader:ImageLoader.Source="{Binding IconUrl}"/>
									</Border>
									<TextBlock Classes="item-title" TextWrapping="Wrap" Grid.Row="0" Margin="6" Grid.Column="1" Text="{Binding Title}"/>
									<SelectableTextBlock Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" Margin="4,8,0,0" Grid.Row="1" Grid.Column="1" Text="{Binding Description}"/>
									<Button Classes="item-action" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Command="{Binding $parent[ListBox].DataContext.ToInstallModCommand}" CommandParameter="{Binding}">
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="安装"/>
										</StackPanel>
									</Button>
								</Grid>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</StackPanel>
		</ScrollViewer>
	</controls:PageShell>
</UserControl>

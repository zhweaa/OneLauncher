<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:OneLauncher.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OneLauncher.Views.ViewModels"
             xmlns:controls="using:OneLauncher.Views.Controls"
             xmlns:lo="using:OneLauncher.Core.Helper.Models" mc:Ignorable="d" d:DesignWidth="818" d:DesignHeight="530"
             x:Class="OneLauncher.Home"
             x:DataType="vm:HomePageViewModel"
			 xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             x:CompileBindings="True">
	<UserControl.Styles>
		<Style Selector="Button.NewsCard">
			<Setter Property="Background" Value="#40FFFFFF" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="Padding" Value="12,8"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="Button.NewsCard:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#80FFFFFF" />
		</Style>

		<Style Selector="Button.NewsCard.Round">
			<Setter Property="Padding" Value="8"/>
			<Setter Property="CornerRadius" Value="100"/>
		</Style>

		<!-- 默认样式中卡片跨越空白列以保持原有居中构图；魔法按钮样式中卡片靠左并为按钮让出空间。 -->
		<Style Selector="ScrollViewer.home-sections">
			<Setter Property="Grid.ColumnSpan" Value="2"/>
		</Style>
		<Style Selector="ScrollViewer.home-sections.magic">
			<Setter Property="Grid.ColumnSpan" Value="1"/>
		</Style>
		<!-- 外层 Border 由 card-list 样式提供阴影与悬停；内层负责圆角裁剪，避免裁掉外层阴影。 -->
		<Style Selector="Border.home-card-clip">
			<Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
			<Setter Property="ClipToBounds" Value="True"/>
		</Style>
		<!-- 自定义背景下卡片改用半透明底色，让背景透出而不显得突兀。 -->
		<Style Selector="ListBox.card-list.on-image ListBoxItem > Border">
			<Setter Property="Background" Value="{DynamicResource HomeCardOnImageBrush}"/>
		</Style>
		<Style Selector="ListBox.card-list.on-image ListBoxItem:pointerover > Border">
			<Setter Property="Background" Value="{DynamicResource HomeCardOnImageHoverBrush}"/>
		</Style>
		<!-- 新闻卡自带图片与深色遮罩，不需要描边。 -->
		<Style Selector="ListBox.card-list ListBoxItem > Border.home-news-card">
			<Setter Property="BorderThickness" Value="0"/>
		</Style>
		<Style Selector="controls|MagicLaunchButton.on-image TextBlock.magic-launch-title">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Effect" Value="drop-shadow(0 3 10 #99000000)"/>
		</Style>
		<!-- 背景图明暗不可预知，悬停阴影加深，保证白色文字下方始终有可见的暗部。 -->
		<Style Selector="controls|MagicLaunchButton.on-image">
			<Setter Property="HoverGlowColor" Value="#8C000000"/>
		</Style>
		<Style Selector="controls|MagicLaunchButton:not(.on-image) TextBlock.magic-launch-title">
			<Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
		</Style>
	</UserControl.Styles>
	<Panel>
		<Image Source="{Binding HomeBackground}"
			   IsVisible="{Binding HasHomeBackground}"
			   Stretch="UniformToFill"
			   HorizontalAlignment="Stretch"
			   VerticalAlignment="Stretch"/>
		<Border IsVisible="{Binding HasHomeBackground}" IsHitTestVisible="False">
			<Border.Background>
				<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
					<GradientStop Color="#00000000" Offset="0.35"/>
					<GradientStop Color="#73000000" Offset="1"/>
				</LinearGradientBrush>
			</Border.Background>
		</Border>
	<controls:PageShell IsPaneOpen="{Binding IsPaneShow,Mode=TwoWay}"
						PaneContent="{Binding PaneContent}">
		
		<Grid ColumnDefinitions="Auto,*,Auto">
					<ScrollViewer Grid.Column="0" Classes="home-sections"
								  Classes.magic="{Binding IsMagicButtonStyle}"
								  VerticalScrollBarVisibility="Hidden"
								  IsVisible="{Binding IsHomeSectionsVisible}">
						<StackPanel>
							<ListBox Classes="card-list" Classes.on-image="{Binding HasHomeBackground}">
								<!-- 板块为固定声明的 ListBoxItem；虚拟化面板回收时会直接改写 IsVisible，覆盖可见性绑定。 -->
								<ListBox.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel/>
									</ItemsPanelTemplate>
								</ListBox.ItemsPanel>
								<ListBoxItem IsVisible="{Binding IsNewsSectionVisible}">
									<Border Classes="home-news-card" Width="385" Height="240">
									<Border Classes="home-card-clip">
										<Panel>
											<Image asyncImageLoader:ImageLoader.Source="{Binding CurrentNews.ImageUrl}" Stretch="UniformToFill" />
											<Border>
												<Border.Background>
													<LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
														<GradientStop Color="#CC000000" Offset="0" />
														<GradientStop Color="#33000000" Offset="0.5" />
														<GradientStop Color="#E6000000" Offset="1" />
													</LinearGradientBrush>
												</Border.Background>
											</Border>

											<TextBlock Text="新闻加载中..."
													   IsVisible="{Binding IsNewsLoading}"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"
													   Foreground="White"
													   FontSize="16"/>

											<Grid IsVisible="{Binding !IsNewsLoading}"
												  RowDefinitions="Auto, *, Auto"
												  Margin="20">

												<StackPanel Grid.Row="0" Spacing="5">
													<TextBlock Text="MINECRAFT 新闻"
															   Foreground="{DynamicResource SystemAccentColorLight2}"
															   FontSize="11"
															   FontWeight="Bold"
															   LetterSpacing="0.1"/>
													<TextBlock Text="{Binding CurrentNews.Title}"
															   Foreground="White"
															   FontSize="20"
															   FontWeight="SemiBold"
															   TextWrapping="WrapWithOverflow"
															   MaxHeight="54"
															   TextTrimming="CharacterEllipsis"/>
												</StackPanel>

												<TextBlock Grid.Row="1"
														   Text="{Binding CurrentNews.Content}"
														   Foreground="#E0E0E0"
														   FontSize="13"
														   TextWrapping="WrapWithOverflow"
														   TextTrimming="CharacterEllipsis"
														   VerticalAlignment="Top"
														   Margin="0,12,0,0"/>

												<StackPanel Grid.Row="2"
															Orientation="Horizontal"
															Spacing="8"
															HorizontalAlignment="Right"
															VerticalAlignment="Bottom">

													<Button Command="{Binding ViewDetailsCommand}"
															Classes="NewsCard"
															Content="阅读详细"/>

													<Button Command="{Binding PreviousNewsCommand}"
															Classes="NewsCard Round"
															ToolTip.Tip="上一条">
														<PathIcon Width="16" Height="16" Data="{x:Static icons:VectorIcons.ChevronLeft}"/>
													</Button>

													<Button Command="{Binding NextNewsCommand}"
															Classes="NewsCard Round"
															ToolTip.Tip="下一条">
														<PathIcon Width="16" Height="16" Data="{x:Static icons:VectorIcons.ChevronRight}"/>
													</Button>
												</StackPanel>
											</Grid>
										</Panel>
									</Border>
									</Border>
								</ListBoxItem>

								<ListBoxItem IsVisible="{Binding IsTaskCenterSectionVisible}">
									<Border Width="385" MinHeight="120">
									<Border Classes="home-card-clip">
										<Grid ColumnDefinitions="5, *, Auto">
											<Border Grid.Column="0" Background="{DynamicResource SuccessBrush}"/>

											<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
												<TextBlock Text="任务中心" FontSize="22" FontWeight="SemiBold"
														Foreground="{DynamicResource PrimaryForegroundBrush}"/>
												<TextBlock Text="查看任务状态和实时进度" FontSize="12"
														Foreground="{DynamicResource SecondaryForegroundBrush}"/>
											</StackPanel>

											<Button Grid.Column="2" Content="进入"
													Command="{Binding OpenTaskCenterCommand}"
													Background="{DynamicResource SuccessBrush}"
													Foreground="White"
													VerticalAlignment="Center"
													HorizontalAlignment="Right"
													Margin="0,0,20,0"
													Padding="25,8"
													CornerRadius="8"/>
										</Grid>
									</Border>
									</Border>
								</ListBoxItem>

								<ListBoxItem IsVisible="{Binding IsPowerPlaySectionVisible}">
									<Border Width="385" Height="120">
									<Border Classes="home-card-clip">
										<Grid ColumnDefinitions="5, *, Auto">
											<Border Grid.Column="0" Background="{DynamicResource AccentBrush}"/>

											<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
												<TextBlock Text="联机面板" FontSize="22" FontWeight="SemiBold"
														   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
												<TextBlock Text="加入社区服务器或与朋友联机" FontSize="12"
														   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
											</StackPanel>

											<Button Grid.Column="2" Content="进入"
													Command="{Binding PowerPlayCommand}"
													Background="{DynamicResource AccentBrush}"
													Foreground="White"
													VerticalAlignment="Center"
													HorizontalAlignment="Right"
													Margin="0,0,20,0"
													Padding="25,8"
													CornerRadius="8"/>
										</Grid>
									</Border>
									</Border>
								</ListBoxItem>

								<ListBoxItem IsVisible="{Binding IsImportSectionVisible}">
									<Border Width="385" MinHeight="160">
									<Border Classes="home-card-clip">
										<Grid ColumnDefinitions="5, *">
											<Border Grid.Column="0" Background="{DynamicResource AccentBrush}"/>

											<StackPanel Grid.Column="1" Margin="20" Spacing="10">
												<StackPanel.Styles>
													<Style Selector="Button.Link">
														<Setter Property="Background" Value="Transparent"/>
														<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
														<Setter Property="HorizontalContentAlignment" Value="Left"/>
														<Setter Property="Padding" Value="10,8"/>
														<Setter Property="Cursor" Value="Hand"/>
														<Setter Property="FontWeight" Value="Medium"/>
													</Style>
													<Style Selector="Button.Link:pointerover /template/ ContentPresenter">
														<Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
													</Style>
												</StackPanel.Styles>

												<TextBlock Text="导入游戏实例" FontSize="18" FontWeight="SemiBold"
														   Foreground="{DynamicResource PrimaryForegroundBrush}"/>

												<Button Classes="Link" Command="{Binding ImportVersionByPCL2Command}">
													<TextBlock Text="从 PCL2 导入..."/>
												</Button>

												<Button Classes="Link" Command="{Binding ImportCommand}">
													<TextBlock Text="从整合包 (.mrpack) 导入..."/>
												</Button>
											</StackPanel>
										</Grid>
									</Border>
									</Border>
								</ListBoxItem>

							</ListBox>
						</StackPanel>
					</ScrollViewer>
			<!-- 魔法按钮只启动设置页中的主页默认启动项，不在主页提供选择。 -->
			<controls:MagicLaunchButton Grid.Column="1" x:Name="MagicLaunchButton"
										IsVisible="{Binding IsMagicButtonStyle}"
										Command="{Binding LaunchDefaultCommand}"
										Classes.on-image="{Binding HasHomeBackground}"
										HorizontalAlignment="Right"
										VerticalAlignment="Bottom"
										Margin="24,24,28,26"
										ToolTip.Tip="{Binding MagicLaunchDescription}"
										AutomationProperties.Name="启动主页默认启动项">
				<!-- 按钮主体只显示启动项名称；类型与地址保留在悬停提示中。 -->
				<Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
					<controls:InkCenteredTextBlock Classes="magic-launch-title" Text="{Binding MagicLaunchTitle}"/>
				</Viewbox>
			</controls:MagicLaunchButton>
			<Panel Grid.Column="2" Width="300"
				   IsVisible="{Binding IsClassicStyle}"
				   Background="{DynamicResource PaneBackgroundBrush}">
				<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
					<Image Source="{Binding GameIcon}" Height="128" Width="128"/>

					<ComboBox x:Name="QuickLaunchComboBox"
							  ItemsSource="{Binding Items}" 
							  SelectedItem="{Binding SelectedLaunchItem}" 
							  PlaceholderText="选择启动项"
							  Width="128">
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="vm:IQuicklyLaunchItem">
								<TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
										   ToolTip.Tip="{Binding Description}"/>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>

					<Button Command="{Binding LaunchCommand}" Width="128">
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
							<Image Source="{DynamicResource IconLaunch}" Width="20" Height="20"/>
							<TextBlock Text="快速游戏"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Panel>
		</Grid>
	</controls:PageShell>
	</Panel>
</UserControl>

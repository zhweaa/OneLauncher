<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style Selector="ListBox.card-list">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="6,4,10,10"/>
		<Setter Property="ClipToBounds" Value="False"/>
	</Style>
	<Style Selector="ListBox.card-list ListBoxItem">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Margin" Value="6,7"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="ClipToBounds" Value="False"/>
	</Style>
	<Style Selector="ListBox.card-list ListBoxItem /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="ClipToBounds" Value="False"/>
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Opacity" Duration="0:0:0.14"/>
			</Transitions>
		</Setter>
	</Style>
	<Style Selector="ListBox.card-list ListBoxItem:pointerover /template/ ContentPresenter">
		<Setter Property="Opacity" Value="1"/>
	</Style>
	<Style Selector="ListBox.card-list ListBoxItem:selected /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>
	<Style Selector="ListBox.card-list ListBoxItem:selected:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>
	<Style Selector="ListBox.card-list ListBoxItem:selected:pressed /template/ ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>
	<Style Selector="ListBox.card-list ListBoxItem:pressed /template/ ContentPresenter">
		<Setter Property="Opacity" Value="0.96"/>
	</Style>
	<Style Selector="ListBox.card-list ListBoxItem > Border">
		<Setter Property="ClipToBounds" Value="False"/>
		<Setter Property="Background" Value="{DynamicResource ListItemBackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
		<Setter Property="BoxShadow" Value="0 4 14 1 #32000000"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.16"/>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
				<BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16"/>
			</Transitions>
		</Setter>
	</Style>
	<Style Selector="ListBox.card-list ListBoxItem:selected > Border">
		<Setter Property="Background" Value="{DynamicResource ListItemBackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
		<Setter Property="BoxShadow" Value="0 4 14 1 #32000000"/>
	</Style>
	<Style Selector="ListBox.card-list ListBoxItem:pointerover > Border">
		<Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
		<Setter Property="BoxShadow" Value="0 8 24 2 #42000000"/>
	</Style>
	<Style Selector="ListBox.card-list ListBoxItem:pressed > Border">
		<Setter Property="BoxShadow" Value="0 2 8 1 #2A000000"/>
	</Style>
</Styles>

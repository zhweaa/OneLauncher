<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OneLauncher.Views.Panes.PaneViewModels"
             xmlns:controls="using:OneLauncher.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="620"
             x:DataType="vm:GameDataModsManagerPaneViewModel"
             x:CompileBindings="True"
             x:Class="OneLauncher.Views.Panes.GameDataModsManagerPane">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <controls:PaneHeader Grid.Row="0" Title="模组管理" BackCommand="{Binding ClosePaneCommand}">
            <controls:PaneHeader.TrailingContent>
                <Button Classes="pane-toolbar" Command="{Binding RefreshModsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="/Assets/icos/refresh.png" Width="20" Height="20"/>
                        <TextBlock Text="刷新"/>
                    </StackPanel>
                </Button>
            </controls:PaneHeader.TrailingContent>
        </controls:PaneHeader>
        <Separator Grid.Row="1" Classes="pane-divider"/>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Mods}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstanceModItem">
                        <Border Classes="pane-surface" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Width="42" Height="42" CornerRadius="6" ClipToBounds="True">
                                    <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding Info.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Classes="pane-help" Text="{Binding Info.Description}" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Classes="pane-help" Text="{Binding Info.Version}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding ModEnabledManager}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="3" Classes="pane-secondary" Content="打开 Mods 文件夹"
                Command="{Binding OpenModsFolderCommand}" HorizontalAlignment="Stretch" Margin="0,16,0,0"/>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OneLauncher.Views.Panes.PaneViewModels"
             xmlns:controls="using:OneLauncher.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="620"
             x:DataType="vm:DownloadPaneViewModel"
             x:CompileBindings="True"
             x:Class="OneLauncher.Views.Panes.DownloadPane">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <controls:PaneHeader Grid.Row="0" Title="{Binding VersionName}" BackCommand="{Binding ClosePaneCommand}">
            <controls:PaneHeader.TrailingContent>
                <Button Classes="pane-toolbar" Command="{Binding PopUpCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="/Assets/icos/internet.png" Width="20" Height="20"/>
                        <TextBlock Text="弹出" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </controls:PaneHeader.TrailingContent>
        </controls:PaneHeader>
        <Separator Grid.Row="1" Classes="pane-divider"/>

        <ScrollViewer Grid.Row="2">
            <StackPanel MaxWidth="540" HorizontalAlignment="Stretch" Spacing="16" Margin="0,0,0,20">
                <TextBlock Classes="pane-section-title" Text="安装选项"/>
                <Border Classes="pane-surface">
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="24"
                          RowSpacing="12">
                        <CheckBox Grid.Row="0" Grid.Column="0"
                                  IsEnabled="{Binding IsAllowFabric}"
                                  IsChecked="{Binding IsMod}"
                                  Content="Fabric"/>
                        <CheckBox Grid.Row="0" Grid.Column="1"
                                  IsVisible="{Binding IsMod}"
                                  IsChecked="{Binding IsDownloadFabricWithAPI}"
                                  Content="同时安装 Fabric API"/>

                        <CheckBox Grid.Row="1" Grid.Column="0"
                                  IsEnabled="{Binding IsAllowFabric}"
                                  IsChecked="{Binding IsQuilt}"
                                  Content="Quilt"/>
                        <CheckBox Grid.Row="1" Grid.Column="1"
                                  IsVisible="{Binding IsQuilt}"
                                  IsChecked="{Binding IsDownloadQuiltWithQSL}"
                                  Content="同时安装 QSL"/>

                        <CheckBox Grid.Row="2" Grid.Column="0"
                                  IsEnabled="{Binding IsAllowNeoforge}"
                                  IsChecked="{Binding IsNeoForge}"
                                  Content="NeoForge"/>
                        <CheckBox Grid.Row="2" Grid.Column="1"
                                  IsVisible="{Binding IsNeoForge}"
                                  IsChecked="{Binding IsAllowToUseBetaNeoforge}"
                                  Content="允许 Beta 版本"/>

                        <CheckBox Grid.Row="3" Grid.Column="0"
                                  IsEnabled="{Binding IsAllowForge}"
                                  IsChecked="{Binding IsForge}"
                                  Content="Forge（预览）"/>
                        <CheckBox Grid.Row="3" Grid.Column="1"
                                  IsVisible="{Binding IsForge}"
                                  IsChecked="{Binding IsUseRecommendedToInstallForge}"
                                  Content="优先使用推荐版"/>

                        <CheckBox Grid.Row="4" Grid.ColumnSpan="2"
                                  IsChecked="{Binding IsJava}"
                                  Content="自动安装匹配的 Java 运行环境"/>
                    </Grid>
                </Border>

                <TextBlock Classes="pane-section-title" Text="下载状态"/>
                <Border Classes="pane-status">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="{Binding Dp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Classes="pane-help" Text="{Binding Fs}"/>
                        </Grid>
                        <TextBlock Classes="pane-help" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Classes="pane-progress"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding CurrentProgress}"
                                     ShowProgressText="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,16,0,0">
            <Button Grid.Column="0"
                    Classes="pane-danger"
                    Content="取消任务"
                    Command="{Binding ToCancellationDownloadTaskCommand}"
                    IsEnabled="{Binding !#ToDownloadButton.IsEnabled}"/>
            <Button Grid.Column="1"
                    x:Name="ToDownloadButton"
                    Classes="pane-primary"
                    Content="下载版本"
                    Command="{Binding ToDownloadCommand}"
                    IsEnabled="{Binding IsAllowDownloading}"/>
        </Grid>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OneLauncher.Views.Panes.PaneViewModels"
             xmlns:controls="using:OneLauncher.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="620"
             x:DataType="vm:DownloadPaneViewModel"
             x:CompileBindings="True"
             x:Class="OneLauncher.Views.Panes.DownloadPane">
    <UserControl.Styles>
        <Style Selector="Border.download-status.finished">
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
        </Style>
        <Style Selector="Border.download-status.failed">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
        </Style>
        <Style Selector="Border.download-status.canceled">
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
            <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <controls:PaneHeader Grid.Row="0" Title="{Binding VersionName}" BackCommand="{Binding ClosePaneCommand}">
            <controls:PaneHeader.TrailingContent>
                <Button Classes="pane-toolbar" Command="{Binding PopUpCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="{DynamicResource IconInternet}" Width="20" Height="20"/>
                        <TextBlock Text="弹出" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </controls:PaneHeader.TrailingContent>
        </controls:PaneHeader>
        <Separator Grid.Row="1" Classes="pane-divider"/>

        <ScrollViewer Grid.Row="2">
            <StackPanel MaxWidth="540" HorizontalAlignment="Stretch" Spacing="16" Margin="0,0,0,20">
                <TextBlock Classes="pane-section-title" Text="安装选项"/>
                <Border Classes="pane-surface" IsEnabled="{Binding !IsDownloading}">
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="24"
                          RowSpacing="12">
                        <CheckBox Grid.Row="0" Grid.Column="0"
                                  IsEnabled="{Binding IsAllowFabric}"
                                  IsChecked="{Binding IsMod}"
                                  Content="Fabric"/>
                        <CheckBox Grid.Row="0" Grid.Column="1"
                                  IsVisible="{Binding IsMod}"
                                  IsChecked="{Binding IsDownloadFabricWithAPI}"
                                  Content="同时安装 Fabric API"/>

                        <CheckBox Grid.Row="1" Grid.Column="0"
                                  IsEnabled="{Binding IsAllowFabric}"
                                  IsChecked="{Binding IsQuilt}"
                                  Content="Quilt"/>
                        <CheckBox Grid.Row="1" Grid.Column="1"
                                  IsVisible="{Binding IsQuilt}"
                                  IsChecked="{Binding IsDownloadQuiltWithQSL}"
                                  Content="同时安装 QSL"/>

                        <CheckBox Grid.Row="2" Grid.Column="0"
                                  IsEnabled="{Binding IsAllowNeoforge}"
                                  IsChecked="{Binding IsNeoForge}"
                                  Content="NeoForge"/>
                        <CheckBox Grid.Row="2" Grid.Column="1"
                                  IsVisible="{Binding IsNeoForge}"
                                  IsChecked="{Binding IsAllowToUseBetaNeoforge}"
                                  Content="允许 Beta 版本"/>

                        <CheckBox Grid.Row="3" Grid.Column="0"
                                  IsEnabled="{Binding IsAllowForge}"
                                  IsChecked="{Binding IsForge}"
                                  Content="Forge（预览）"/>
                        <CheckBox Grid.Row="3" Grid.Column="1"
                                  IsVisible="{Binding IsForge}"
                                  IsChecked="{Binding IsUseRecommendedToInstallForge}"
                                  Content="优先使用推荐版"/>

                        <CheckBox Grid.Row="4" Grid.ColumnSpan="2"
                                  IsChecked="{Binding IsJava}"
                                  Content="自动安装匹配的 Java 运行环境"/>
                    </Grid>
                </Border>

                <TextBlock Classes="pane-section-title" Text="下载状态"/>
                <Border x:Name="DownloadStatusCard" Classes="pane-status download-status"
                        Classes.finished="{Binding IsFinished}" Classes.failed="{Binding IsFailed}"
                        Classes.canceled="{Binding IsCanceled}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{Binding StatusIcon}" Width="18" Height="18"
                                      Foreground="{Binding #DownloadStatusCard.BorderBrush}"/>
                            <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                                       Foreground="{Binding #DownloadStatusCard.BorderBrush}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock Classes="pane-help" Text="当前进度" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Dp}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Classes="pane-help" Text="{Binding Fs}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Classes="pane-help" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Classes="pane-progress"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding CurrentProgress}"
                                     Foreground="{Binding #DownloadStatusCard.BorderBrush}"
                                     ShowProgressText="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,16,0,0">
            <Button Grid.Column="0"
                    Classes="pane-danger"
                    HorizontalAlignment="Stretch"
                    Content="{Binding CancelLabel}"
                    Command="{Binding ToCancellationDownloadTaskCommand}"/>
            <Button Grid.Column="1"
                    x:Name="ToDownloadButton"
                    Classes="pane-primary"
                    HorizontalAlignment="Stretch"
                    Content="下载版本"
                    Command="{Binding ToDownloadCommand}"
                    IsEnabled="{Binding IsAllowDownloading}"/>
        </Grid>
    </Grid>
</UserControl>

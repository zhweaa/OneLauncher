<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lo="using:OneLauncher.Core.Helper.Models"
             xmlns:sys="using:System"
             xmlns:vm="using:OneLauncher.Views.Panes.PaneViewModels"
             xmlns:controls="using:OneLauncher.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="620"
             x:Class="OneLauncher.Views.Panes.InstallModPane"
             x:DataType="vm:InstallModPaneViewModel"
             x:CompileBindings="True">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <controls:PaneHeader Grid.Row="0" Title="{Binding PaneTitle}" BackCommand="{Binding ClosePaneCommand}"/>
        <Separator Grid.Row="1" Classes="pane-divider"/>

        <ScrollViewer Grid.Row="2">
            <StackPanel MaxWidth="520" HorizontalAlignment="Stretch" Spacing="16" Margin="0,0,0,20">
                <TextBlock Classes="pane-section-title" Text="安装目标"/>
                <Border Classes="pane-surface">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="pane-label" Text="游戏实例"/>
                        <ComboBox Classes="pane-field" ItemsSource="{Binding AvailableGameData}"
                                  SelectedItem="{Binding SelectedGameData}" IsEnabled="{Binding CanEdit}"
                                  PlaceholderText="选择要安装到的游戏实例">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="lo:GameData">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Classes="pane-help" Text="{Binding VersionId}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="pane-help" Text="暂无游戏实例，请先在游戏数据中创建实例。" IsVisible="{Binding !HasInstances}"/>
                        <CheckBox x:Name="DependenciesCheckBox" IsChecked="{Binding IsICS}" Content="同时下载依赖"
                                  IsVisible="{Binding IsMod}" IsEnabled="{Binding CanEdit}"/>
                        <TextBlock Classes="pane-help" IsVisible="{Binding IsShaderPack}"
                                   Text="安装后可在游戏的光影设置中选择该光影包。"/>
                    </StackPanel>
                </Border>

                <Expander x:Name="SupportedVersionsExpander" IsVisible="{Binding IsShowMoreInfo}" Header="支持的版本"
                          IsExpanded="False" HorizontalAlignment="Stretch">
                    <Border Classes="pane-surface" MaxHeight="190">
                        <ListBox Classes="card-list" ItemsSource="{Binding SupportVersions}" Focusable="False">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Setter Property="Focusable" Value="False"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <TextBlock Classes="pane-help" Text="{Binding}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Expander>

                <TextBlock Classes="pane-section-title" Text="安装状态"/>
                <Border Classes="pane-status" BorderBrush="{Binding StatusBrush}" Background="{Binding StatusSurfaceBrush}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{Binding StatusIcon}" Width="18" Height="18" Foreground="{Binding StatusBrush}"/>
                            <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Dp}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Classes="pane-help" Text="{Binding Fs}" Margin="12,0,0,0"/>
                        </Grid>
                        <ProgressBar Classes="pane-progress" Minimum="0" Maximum="100" Value="{Binding CurrentProgress}"
                                     Foreground="{Binding StatusBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,16,0,0">
            <Button Grid.Column="0" Classes="pane-danger" Content="{Binding CancelLabel}"
                    Command="{Binding CancelInstallCommand}" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1" Classes="pane-primary" Content="安装" Command="{Binding ToInstallCommand}"
                    HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</UserControl>

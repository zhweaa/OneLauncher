<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OneLauncher.Views.Panes.PaneViewModels"
             xmlns:controls="using:OneLauncher.Views.Controls"
             x:Class="OneLauncher.Views.Panes.EditServerPane"
             x:DataType="vm:EditServerPaneViewModel"
             x:CompileBindings="True"
             mc:Ignorable="d"
             d:DesignWidth="650"
             d:DesignHeight="620">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <controls:PaneHeader Grid.Row="0" Title="编辑服务器收藏" BackCommand="{Binding CancelCommand}"/>
        <Separator Grid.Row="1" Classes="pane-divider"/>

        <ScrollViewer Grid.Row="2">
            <StackPanel MaxWidth="540"
                        HorizontalAlignment="Stretch"
                        Spacing="16"
                        Margin="0,0,0,20">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border Width="88"
                            Height="88"
                            CornerRadius="6"
                            ClipToBounds="True"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <Image Source="{Binding CurrentIcon}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="6">
                        <TextBlock Classes="pane-section-title" Text="服务器图标" />
                        <TextBlock Classes="pane-help" Text="用于在服务器收藏列表中识别此服务器" />
                        <Button Classes="pane-secondary"
                                Content="更改图标"
                                Command="{Binding ChangeIconCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>

                <TextBlock Classes="pane-section-title" Text="基本信息" />
                <Border Classes="pane-surface">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="pane-label" Text="服务器名称" />
                        <TextBox Classes="pane-field" Text="{Binding ServerName}" />
                        <TextBlock Classes="pane-label" Text="服务器描述" Margin="0,8,0,0" />
                        <TextBox Classes="pane-field"
                                 Text="{Binding ServerDescription}"
                                 Watermark="输入服务器描述（可选）"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80" />
                    </StackPanel>
                </Border>

                <TextBlock Classes="pane-section-title" Text="服务器连接配置" />
                <Border Classes="pane-surface">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="pane-label" Text="地址（IP）" />
                        <TextBox Classes="pane-field" 
                                 Text="{Binding ServerIP}" 
                                 Watermark="输入服务器IP地址（不含端口）"/>
                        <TextBlock Classes="pane-label" Text="服务器端口号" Margin="0,8,0,0" />
                        <TextBox Classes="pane-field"
                                 Text="{Binding ServerPort}"
                                 Watermark="输入服务器地址中的端口（如25565）"/>
                    </StackPanel>
                </Border>

                <TextBlock Classes="pane-section-title" Text="服务器工具" />
                <Border Classes="pane-surface">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="pane-secondary"
                                Content="获取服务器信息"
                                Command="{Binding GetServerInfoCommand}" />
                        <Button Classes="pane-secondary"
                                Content="打开实例信息编辑器"
                                Command="{Binding EditGameDataCommand}" />
                        <Button Classes="pane-secondary"
                                Content="创建桌面快捷启动"
                                Command="{Binding AddToQuicklyPlayCommand}" />
                    </StackPanel>
                </Border>

                <TextBlock Classes="pane-section-title" Text="危险操作" />
                <Button Classes="pane-danger" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <Image Source="/Assets/icos/del.png" Width="20" Height="20" />
                        <TextBlock Text="删除服务器收藏" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Width="320" Spacing="10">
                                <TextBlock Text="确认删除服务器收藏？"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Classes="pane-help"
                                           Text="服务器收藏记录将被删除，此操作无法撤销。" />
                                <Separator />
                                <Grid ColumnDefinitions="Auto,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                      RowSpacing="6">
                                    <TextBlock Classes="pane-label" Text="名称" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding OriginalName}"
                                               Margin="12,0,0,0" />
                                    <TextBlock Grid.Row="1" Classes="pane-label" Text="地址" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding Address}"
                                               Margin="12,0,0,0" />
                                    <TextBlock Grid.Row="2" Classes="pane-label" Text="实例" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{Binding InstanceId}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="12,0,0,0" />
                                    <TextBlock Grid.Row="3" Classes="pane-label" Text="标识符" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Text="{Binding Id}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="12,0,0,0" />
                                </Grid>
                                <Button Classes="pane-danger"
                                        Content="确认删除"
                                        Command="{Binding DeleteServerCommand}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,*"
              ColumnSpacing="10"
              Margin="0,16,0,0">
            <Button Grid.Column="0"
                    Classes="pane-secondary"
                    Content="取消"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="1"
                    Classes="pane-primary"
                    Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <Image Source="/Assets/icos/save.png" Width="20" Height="20" />
                    <TextBlock Text="保存" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>

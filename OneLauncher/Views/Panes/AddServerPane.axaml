<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OneLauncher.Views.Panes.PaneViewModels"
             xmlns:controls="using:OneLauncher.Views.Controls"
             xmlns:models="using:OneLauncher.Core.Helper.Models"
             mc:Ignorable="d"
             d:DesignWidth="650"
             d:DesignHeight="620"
             x:DataType="vm:AddServerPaneViewModel"
             x:CompileBindings="True"
             x:Class="OneLauncher.Views.Panes.AddServerPane">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <controls:PaneHeader Grid.Row="0" Title="添加服务器收藏" BackCommand="{Binding CancelCommand}"/>
        <Separator Grid.Row="1" Classes="pane-divider"/>

        <ScrollViewer Grid.Row="2">
            <StackPanel MaxWidth="520"
                        HorizontalAlignment="Stretch"
                        Spacing="16"
                        Margin="0,0,0,20">
                <TextBlock Classes="pane-section-title" Text="基础实例" />
                <Border Classes="pane-surface">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="pane-label" Text="游戏实例" />
                        <ComboBox Classes="pane-field"
                                  ItemsSource="{Binding AvailableInstances}"
                                  SelectedItem="{Binding SelectedInstance}"
                                  PlaceholderText="选择用于启动服务器的游戏实例">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:GameData">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Classes="pane-help" Text="{Binding VersionId}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <TextBlock Classes="pane-section-title" Text="服务器基本信息" />
                <Border Classes="pane-surface">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="pane-label" Text="服务器地址" />
                        <TextBox Classes="pane-field"
                                 Text="{Binding ServerAddress}"
                                 Watermark="例如：mc.example.com" />
                        <TextBlock Classes="pane-label" Text="服务器端口" Margin="0,8,0,0" />
                        <TextBox Classes="pane-field"
                                 Text="{Binding ServerPort}"
                                 Watermark="25565" />
                    </StackPanel>
                </Border>

                <TextBlock Classes="pane-section-title" Text="服务器额外信息" />
                <Border Classes="pane-surface">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="pane-label" Text="名称" />
                        <TextBox Classes="pane-field"
                                 Text="{Binding ServerName}"
                                 Watermark="输入服务器名称（必填）" />
                        <TextBlock Classes="pane-label" Text="描述" Margin="0,8,0,0" />
                        <TextBox Classes="pane-field"
                                 Text="{Binding ServerDescription}"
                                 Watermark="输入服务器描述（可选）"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,*"
              ColumnSpacing="10"
              Margin="0,16,0,0">
            <Button Grid.Column="0"
                    Classes="pane-secondary"
                    Content="取消"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="1"
                    Classes="pane-primary"
                    Content="添加"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</UserControl>

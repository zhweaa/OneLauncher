<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="818" d:DesignHeight="530"
             x:Class="OneLauncher.Views.account"
			 xmlns:vm="using:OneLauncher.Views.ViewModels"
			 xmlns:controls="using:OneLauncher.Views.Controls"
			 x:CompileBindings="True"
			 x:DataType="vm:AccountPageViewModel"
			 >
	<controls:PageShell IsPaneOpen="{Binding IsPaneShow,Mode=TwoWay}"
						PaneContent="{Binding AccountPane}">
		<Grid RowDefinitions="52,Auto,*" Margin="24">
		<StackPanel Margin="16,0,0,0" Orientation="Horizontal" Grid.Row="0" Spacing="28" >
			<TextBlock Classes="page-title" Text="账户管理"/>
			<Button Classes="toolbar-action" Command="{Binding NewUserModelCommand}">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<Image Source="/Assets/icos/add.png" Width="20" Height="20"/>
					<TextBlock Text="新建"/>
				</StackPanel>
			</Button>
			<Button Classes="toolbar-action" Command="{Binding RefreshCommand}">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<Image Source="/Assets/icos/refresh.png" Width="20" Height="20"/>
					<TextBlock Text="刷新"/>
				</StackPanel>
			</Button>
		</StackPanel>
		<TextBlock Classes="page-subtitle" Margin="16,0,0,8" Text="第三方 API 可能导致正版皮肤显示延迟" Grid.Row="1"/>
		<ListBox x:Name="navVL" Classes="card-list" Grid.Row="2" ItemsSource="{Binding UserModelList}" SelectionMode="Multiple">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="vm:UserItem">
					<Border Padding="10">
						<Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
							<Border Grid.Column="0" CornerRadius="6" ClipToBounds="True">
								<Image Width="64" Height="64" Source="{Binding HeadImg}"/>
							</Border>

							<StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center">
								<TextBlock Classes="item-title" Text="{Binding um.Name}"/>

								<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,0">
									<TextBlock Classes="item-meta">
										<Run Text="类型:"/>
										<Run Text="{Binding um}"/>
									</TextBlock>
									<TextBlock Classes="item-meta">
										<Run Text="UUID:"/>
										<Run Text="{Binding um.uuid}"/>
									</TextBlock>
								</StackPanel>
							</StackPanel>

							<StackPanel Grid.Column="2" Spacing="8" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6">

								<Border Classes="status-badge" IsVisible="{Binding IsDefault}">
									<TextBlock Text="默认"/>
								</Border>
								<Button Classes="item-action" IsVisible="{Binding IsNotDefault}"
										Command="{Binding $parent[ListBox].DataContext.SetDefaultCommand}"
										CommandParameter="{Binding}">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Image Source="/Assets/icos/pin.png" Width="16" Height="16"/>
										<TextBlock Text="设为默认"/>
									</StackPanel>
								</Button>
								
								<Button Classes="item-action" IsVisible="{Binding IsMsaUser}"
										Command="{Binding $parent[ListBox].DataContext.SkinMangerCommand}"
										CommandParameter="{Binding um}">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Image Source="/Assets/icos/skin.png" Width="16" Height="16"/>
										<TextBlock Text="皮肤管理"/>
									</StackPanel>
								</Button>							

								<Button Classes="item-action danger-action"
										Command="{Binding $parent[ListBox].DataContext.DeleteUserCommand}"
										CommandParameter="{Binding um}">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Image Source="/Assets/icos/del.png" Width="16" Height="16"/>
										<TextBlock Text="移除" />
									</StackPanel>
								</Button>
							</StackPanel>
						</Grid>
					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Grid>
	</controls:PageShell>
</UserControl>

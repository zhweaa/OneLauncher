            <Bitmap x:Key="IconSkin">avares://OneLauncher/Assets/icos/skin.png</Bitmap>
            <Bitmap x:Key="IconVersion">avares://OneLauncher/Assets/icos/version.png</Bitmap>
            <!-- END GENERATED ICONS: Light -->
            <SolidColorBrush x:Key="MainWindowBackgroundBrush" Color="#99FFFFFF"/>

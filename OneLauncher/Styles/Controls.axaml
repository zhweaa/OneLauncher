<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:OneLauncher.Views.Controls">
    <Style Selector="Button.toolbar-action">
        <Setter Property="Height" Value="{StaticResource ToolbarControlHeight}"/>
        <Setter Property="MinHeight" Value="{StaticResource ToolbarControlHeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource ListItemBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.toolbar-action /template/ ContentPresenter">
        <Setter Property="BoxShadow" Value="0 3 10 1 #32000000"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.14"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.toolbar-action:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BoxShadow" Value="0 6 16 1 #42000000"/>
    </Style>
    <Style Selector="Button.toolbar-action:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
        <Setter Property="BoxShadow" Value="0 1 5 0 #26000000"/>
    </Style>
    <Style Selector="Button.toolbar-action StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="7"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.toolbar-action StackPanel > Image">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.toolbar-action StackPanel > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style Selector="Button.item-action">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.item-action StackPanel > Image">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.item-action StackPanel > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.danger-action">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
    </Style>
    <Style Selector="Button.danger-action:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>

    <Style Selector="Border.status-badge">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.status-badge.warning">
        <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
    </Style>
    <Style Selector="Border.status-badge.danger">
        <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style Selector="Border.status-badge.success">
        <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
    </Style>
    <Style Selector="Border.status-badge > TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Border.status-badge.warning > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
    </Style>
    <Style Selector="Border.status-badge.danger > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style Selector="Border.status-badge.success > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
    </Style>

    <Style Selector="TextBox.search-field">
        <Setter Property="Height" Value="{StaticResource ToolbarControlHeight}"/>
        <Setter Property="MinHeight" Value="{StaticResource ToolbarControlHeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
    </Style>
    <Style Selector="AutoCompleteBox.search-field">
        <Setter Property="Height" Value="{StaticResource ToolbarControlHeight}"/>
        <Setter Property="MinHeight" Value="{StaticResource ToolbarControlHeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
    </Style>
    <Style Selector="AutoCompleteBox.search-field /template/ TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox.toolbar-field">
        <Setter Property="Height" Value="{StaticResource ToolbarControlHeight}"/>
        <Setter Property="MinHeight" Value="{StaticResource ToolbarControlHeight}"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="NumericUpDown.settings-number">
        <Setter Property="Width" Value="150"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style Selector="Separator.section-divider">
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="StackPanel.settings-section">
        <Setter Property="Spacing" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MaxWidth" Value="760"/>
    </Style>
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource FlyoutBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource FlyoutBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="controls|MagicLaunchButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="28,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="HoverGlowColor" Value="#38000000"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:MagicLaunchButton">
                <!-- 悬停与扩散阴影位于文字下方并按圆角裁剪，阴影加深时文字仍清晰可读。 -->
                <Border x:Name="PART_Surface"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">
                    <Border CornerRadius="8" ClipToBounds="True">
                        <Panel>
                            <Canvas x:Name="PART_HoverLayer" IsHitTestVisible="False">
                                <Ellipse x:Name="PART_HoverGlow" Opacity="0" IsHitTestVisible="False">
                                    <Ellipse.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
                                        </Transitions>
                                    </Ellipse.Transitions>
                                </Ellipse>
                            </Canvas>
                            <Canvas x:Name="PART_BurstLayer" IsHitTestVisible="False"/>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"/>
                        </Panel>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|MagicLaunchButton /template/ Border#PART_Surface">
        <Setter Property="RenderTransform" Value="translate(0px, 0px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="controls|MagicLaunchButton:pressed /template/ Border#PART_Surface">
        <Setter Property="RenderTransform" Value="translate(0px, 1px)"/>
    </Style>
    <Style Selector="controls|MagicLaunchButton:disabled /template/ Border#PART_Surface">
        <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="controls|MagicLaunchButton TextBlock.magic-launch-title">
        <Setter Property="FontSize" Value="58"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="MaxWidth" Value="520"/>
    </Style>
</Styles>
